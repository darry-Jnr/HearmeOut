# LOCAL DEV (npm run dev) — direct ElevenLabs call from the browser.
# Put your real key in `.env` (NOT committed to git). Copy this file to `.env`.
VITE_ELEVENLABS_API_KEY=
# Optional: pick a voice. "21m00Tcm4TlvDq8ikWAM" is "Rachel".
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- PRODUCTION (Vercel) ---
# Do NOT set the VITE_ variables above in Vercel. Instead set these in
# Vercel -> Project Settings -> Environment Variables (server-side only).
# They are never sent to the browser; api/speak.ts uses them on the server.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
